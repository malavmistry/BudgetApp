{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/BudgetApp/BudgetApp.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/BudgetApp/BudgetApp.csproj"
			],
			"problemMatcher": "$msCompile",
			"isBackground": true
		},
		{
			"label": "add-recurring-item-migration",
			"type": "shell",
			"command": "C:\\Program Files\\dotnet\\dotnet.exe",
			"args": [
				"ef",
				"migrations",
				"add",
				"AddRecurringItemTemplates",
				"--project",
				"BudgetApp/BudgetApp.csproj",
				"--startup-project",
				"BudgetApp/BudgetApp.csproj",
				"--output-dir",
				"Data/Migrations"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}